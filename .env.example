# ABTP Stage 006 configuration defaults.
# Copy to .env for local development only. Never commit real credentials.

# Profile selection. Default stays non-live.
ABTP_PROFILE=paper

# Safety controls. Live mode requires ABTP_PROFILE=live, SAFE_MODE=false,
# ABTP_ENABLE_LIVE_TRADING=true, the documented manual confirmation phrase,
# and separate live credential environment variables.
SAFE_MODE=true
ABTP_TRADING_MODE=paper
ABTP_ENABLE_LIVE_TRADING=false
ABTP_ENABLE_PAPER_TRADING=true
ABTP_LIVE_MANUAL_CONFIRMATION=

# Environment identity
ABTP_ENV=development
ABTP_LOG_LEVEL=INFO
ABTP_AUDIT_EVENT_SINK=stdout
ABTP_DATABASE_URL=sqlite:///./abtp.sqlite3

# Market and data configuration. These are names only; no exchange calls happen
# in configuration modules.
ABTP_EXCHANGES=coinbase,kraken
ABTP_ASSET_UNIVERSE=BTC,USDT
ABTP_CANDLE_INTERVALS=1m,5m,15m,1h,4h,1d
ABTP_DATA_PROVIDERS=fixture,paper

# Risk, fee, and slippage assumptions.
ABTP_MAX_ORDER_NOTIONAL=1000
ABTP_MAX_POSITION_PERCENT=0.10
ABTP_MAX_DAILY_LOSS_PERCENT=0.02
ABTP_MAX_OPEN_ORDERS=5
ABTP_MAKER_FEE_BPS=10
ABTP_TAKER_FEE_BPS=20
ABTP_SLIPPAGE_CEILING_BPS=50

# Live credentials must use separate live variables and must never be committed.
# The application stores only presence-aware secret references, not plaintext
# secret values.
ABTP_LIVE_EXCHANGE_API_KEY=
ABTP_LIVE_EXCHANGE_API_SECRET=
ABTP_LIVE_EXCHANGE_API_PASSPHRASE=

# Stage 031 security metadata. These are non-secret declarations used for
# least-privilege validation. Withdrawal/transfer/margin/futures/options/admin
# scopes are unsupported and must not be present.
ABTP_LIVE_EXCHANGE_SCOPES=read,trade
ABTP_LIVE_EXCHANGE_IP_ALLOWLIST=127.0.0.1
