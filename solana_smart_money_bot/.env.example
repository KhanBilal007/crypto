# Core data providers
HELIUS_API_KEY=
HELIUS_RPC_URL=
JUPITER_BASE_URL=https://api.jup.ag
MONITOR_MODE=polling
BIRDEYE_API_KEY=

# Execution mode
# Paper mode is the default and safest option.
# Live mode is dangerous and must only be enabled with a fresh hot wallet.
# Never use a main wallet private key here.
# Never commit a real .env file.
EXECUTION_MODE=paper
LIVE_TRADING_ENABLED=false
MANUAL_APPROVAL_REQUIRED=true
EMERGENCY_STOP=false
SHADOW_MODE=false
FORWARD_TESTING_MODE=true
PAPER_TRADING=true
EXECUTOR=paper
PRIVATE_KEY=

# Pricing baseline
SOL_INR_PRICE=12000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wallet universe
# Optional bootstrap list. Leave empty to rely on candidate pool.
WHALE_WALLETS=
# Primary dynamic universe source (recommended)
CANDIDATE_WALLETS=
MAX_TRACKED_WALLETS=10
REPLACE_DISABLED_WALLETS=true

# Scoring and sizing
MAX_CONFIDENCE_TRADE_INR=700
MAX_TRADE_INR=300
MAX_TRADE_SIZE_INR=300
OUTCOME_EMA_ALPHA=0.35
MAX_OPEN_POSITIONS=1
MAX_WALLET_EXPOSURE_INR=5000
DAILY_LOSS_LIMIT_INR=500
MAX_TRADES_PER_DAY=5
MAX_LOSS_STREAK=2
MIN_WHALE_CONFIRMATIONS=2
CONFIRMATION_WINDOW_MINUTES=10
MIN_COMBINED_WALLET_SCORE=75
MIN_TOKEN_RISK_SCORE=70
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_BPS=500
MIN_LIQUIDITY_USD=10000
MIN_TOKEN_AGE_MINUTES=30
REQUIRE_MINT_AUTHORITY_DISABLED=true
REQUIRE_FREEZE_AUTHORITY_DISABLED=true
MAX_TOP_HOLDER_PERCENT=25
MAX_TOP_10_HOLDER_PERCENT=70
TX_CONFIRMATION_TIMEOUT_SECONDS=60
TX_CONFIRMATION_POLL_INTERVAL_SECONDS=3
MAX_EXECUTION_RETRIES=2

# Cooldowns & exits
WALLET_TRADE_COOLDOWN_MINUTES=5
TOKEN_TRADE_COOLDOWN_MINUTES=10
TAKE_PROFIT_PERCENT_2=50
TP1_SELL_PERCENT=50
TP2_SELL_PERCENT=25
TRAILING_STOP_PERCENT=12

# External existing-bot bridge
EXTERNAL_EXECUTION_ENABLED=false
COMMAND_BRIDGE_URL=
COMMAND_BRIDGE_TOKEN=
COMMAND_RELAY_MAX_RETRIES=3
TROJAN_BUY_TEMPLATE=/buy {token_mint} {amount_sol}
TROJAN_SELL_TEMPLATE=/sell {token_mint} {sell_percent}
